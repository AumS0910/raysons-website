# Raysons Shell Cast — cache policy
#
# WHY THIS EXISTS
# The server sent no Cache-Control for .html, so browsers fell back to HEURISTIC
# caching: they keep a page for roughly a tenth of its age since Last-Modified,
# with no request to the server at all. Copy that was deleted and deployed kept
# appearing for people who had visited before, and no amount of redeploying could
# reach them, because their browser never asked.
#
# HTML now always revalidates. That is one cheap conditional request per page —
# the server answers 304 Not Modified and sends no body when nothing changed.
# It matters more than it costs: every page carries ?v= content hashes for its own
# CSS and JS, so a stale page pins stale assets to it. Fresh HTML, fresh everything.

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # IMAGES, FONTS AND MEDIA had no Cache-Control at all, so browsers applied the same
  # heuristic guess to them — which is how a replaced portrait could keep showing the
  # old face to anyone who had already visited, with nothing in the deploy to blame.
  #
  # Every reference to these from our HTML now carries a ?v= content hash (see
  # stamp-assets.mjs), so a changed file is a URL the browser has never seen and must
  # fetch. That makes a long cache SAFE rather than risky: the bytes at any given URL
  # never change, and the HTML that names the URL is the thing that always revalidates.
  <FilesMatch "\.(webp|png|jpe?g|svg|avif|gif|ico|woff2?|mp4|glb|gltf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Correct types for the 3D and media the site serves. The casting model was being
# sent as text/plain, which browsers are entitled to refuse.
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType model/gltf+json  .gltf
  AddType image/webp       .webp
  AddType font/woff2       .woff2
  AddType video/mp4        .mp4
</IfModule>
